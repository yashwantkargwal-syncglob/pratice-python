# ==============================================================================
# BLOGGER & GEMINI AUTOMATION ENVIRONMENT CONFIGURATION
# ==============================================================================

# 1. Google Gemini AI API Key (Obtain from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Google Blogger Blog ID (Numeric ID from your Blogger Dashboard URL)
# Example URL: https://www.blogger.com/blog/posts/8492049182391029384 -> ID is 8492049182391029384
BLOGGER_BLOG_ID=your_blogger_blog_id_here

# 3. Path to OAuth2 Client Secrets JSON file from Google Cloud Console
# (Google Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> OAuth 2.0 Client IDs -> Desktop App -> Download JSON)
# IMPORTANT: Enter the filename (e.g. client_secrets.json). DO NOT enter your GOCSPX secret key string here!
GOOGLE_CLIENT_SECRETS_FILE=client_secrets.json

# 4. Path to persist OAuth tokens (auto-generated in same directory after first browser login)
GOOGLE_TOKEN_FILE=token.json

# 5. Geographies to monitor for Tech Trends (US = United States, GB = United Kingdom)
GEO_REGIONS=US,GB

# 6. Target batch post count per run (Default: 5 articles)
POSTS_PER_RUN=5

# 7. Model choice (Supported: gemini-3.8-flash, gemini-flash-latest, gemini-3.1-flash-lite)
GEMINI_MODEL=gemini-3.8-flash

# 8. POST PUBLISHING STATUS: 'DRAFT' or 'LIVE'
# 'DRAFT' (Recommended): Safely stages posts in your Blogger dashboard for human review before publishing.
# 'LIVE': Automatically publishes directly live to your readers immediately!
BLOG_POST_STATUS=DRAFT

# 9. IMAGES CONFIGURATION
# INCLUDE_IMAGES: 'true' (add images to post) or 'false' (pure text & code, no image tags or suggestions)
INCLUDE_IMAGES=true

# IMAGE_MODE: 'direct' or 'suggestion'
# 'direct': Embeds real, high-resolution AI tech illustration figure cards directly in Blogger HTML.
# 'suggestion': Generates attractive designer callout cards with prompt recommendations for manual graphics review.
IMAGE_MODE=direct

# 10. AUTOMATIC INTERNAL BACKLINKING
# 'true': Automatically fetches your already published Blogger posts and seamlessly weaves natural contextual backlinks into the new article!
ENABLE_INTERNAL_LINKING=true

# Maximum number of natural internal backlinks to weave per article (Default: 2)
MAX_INTERNAL_BACKLINKS=2

# 11. ARTICLE MEMORY & DEDUPLICATION DATABASE FILE
# Tracks every article ever written so duplicate topics are NEVER re-generated.
HISTORY_FILE=published_history.json
